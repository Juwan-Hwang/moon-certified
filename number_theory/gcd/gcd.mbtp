///|
/// Postcondition: result is non-negative.
predicate gcd_nonneg(result : Int) {
  0 <= result
}

///|
/// Predicate: d divides n (d | n), the standard mathematical definition.
/// Note: deliberately does NOT require d <= n, since e.g. 5 | 0 and 5 | -5.
predicate divides(d : Int, n : Int) {
  0 < d && n % d == 0
}

///|
/// Lemma: any positive number divides itself.
predicate div_self(d : Int) {
  0 < d → divides(d, d)
}

///|
/// Lemma: any positive number divides 0.
predicate div_zero(d : Int) {
  0 < d → divides(d, 0)
}
